#!/usr/bin/env bash
# After checkout: if landing on master/main and skills/** differ from previous HEAD, sync.
set -euo pipefail
# git post-checkout args: prev_head new_head branch_flag
prev="${1:-}"
new="${2:-}"
branch_flag="${3:-0}"
[[ "$branch_flag" == "1" ]] || exit 0
[[ -n "$prev" && -n "$new" ]] || exit 0
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
source "$ROOT/.githooks/_sync-if-skills-changed.sh"
sync_if_skills_changed "$prev" "$new"
